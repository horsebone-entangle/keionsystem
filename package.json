{
  "name": "keion-room",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:check": "node --env-file=.env scripts/check-postgres.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate-postgres.mjs",
    "db:admin": "node --env-file=.env scripts/create-admin.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.2"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
