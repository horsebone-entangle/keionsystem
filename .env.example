DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres
# Optional PEM CA certificate when required by your database certificate chain.
# DATABASE_CA_CERT=
# Local certificate file (Vercel should use DATABASE_CA_CERT with PEM contents).
# DATABASE_CA_CERT_PATH=prod-ca-2021.crt
# Initial administrator only. Remove these after running db:admin.
# ADMIN_STUDENT_ID=admin001
# ADMIN_NAME=Administrator
# ADMIN_PASSWORD=choose-a-unique-password-at-least-10-characters
